# Copy to .env and fill in the real key. Without OPENAI_API_KEY the server
# still starts and /health works — only /api/llm/test will fail at call time.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SERVICE_NAME=ai-server

# JWT verification (ADR-0023). This server only VERIFIES -- the Spring Boot
# backend is the sole issuer. HS256 is symmetric, so this must be the SAME value
# as `jwt.secret` on the backend (repo-root .env / JWT_SECRET). A mismatch is
# easy to misread: issuing succeeds and only this server returns 401.
JWT_SECRET=gimp_local_dev_secret_change_me_32b
JWT_ISSUER=gimp-backend
