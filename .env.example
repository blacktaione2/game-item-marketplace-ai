# Copy to .env and adjust as needed. docker-compose.yml falls back to the
# gimp_local_pw defaults below if .env is absent, so this file is optional
# for local dev but should be used before anything touches a shared network.

POSTGRES_PORT=5432
POSTGRES_USER=gimp
POSTGRES_PASSWORD=gimp_local_pw
POSTGRES_DB=gimp

ES_HTTP_PORT=9200
ES_TRANSPORT_PORT=9300
ES_HEAP_SIZE=512m

REDIS_PORT=6379
REDIS_PASSWORD=gimp_local_pw

RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=gimp
RABBITMQ_PASSWORD=gimp_local_pw

# JWT signing key (ADR-0023). Symmetric HS256, so the SAME value must also be in
# ai/.env as JWT_SECRET -- the backend issues and both servers verify. If they
# differ, issuing succeeds but only the AI server returns 401, which is a
# confusing symptom. Must be at least 32 bytes.
JWT_SECRET=gimp_local_dev_secret_change_me_32b

# --- 데모 계정 비밀번호 (ADR-0031) --------------------------------------
# **기본값이 없다.** 안 채우면 아무도 로그인하지 못한다 -- 시드의 자리표시자가
# BCrypt 형식이 아니라(29자, 정상은 60자) 어떤 비밀번호와도 매칭되지 않기
# 때문이다. 조용히 열리는 쪽이 아니라 조용히 닫히는 쪽으로 실패한다.
#
# **둘을 다르게 둔다.** 하나면 데모 비밀번호를 아는 사람이 곧바로 GM 이 되고,
# 이상거래 큐가 GM 전용인 것(ADR-0023)이 무의미해진다. prod 프로파일의
# SecretGuard 는 둘이 같으면 기동을 거부한다.
# 공개 배포에서 DEMO_PASSWORD 는 README 에 적어도 되지만 ADMIN_PASSWORD 는 안 된다.
DEMO_PASSWORD=
ADMIN_PASSWORD=

# **X-Forwarded-For 를 신뢰할 출처** (ADR-0031 / 0033). 비어 있으면 헤더를 아예
# 안 읽는다(기본) -- 설정을 잊은 배포가 안전한 쪽으로 실패하게 하기 위해서다.
# 그 경우 로그인 한도(30회/분)가 사용자별이 아니라 **배포 전체의 합계**가 된다.
#
# 배포에서는 nginx 컨테이너의 IP 를 넣는다. 컴포즈 네트워크 IP 는 고정이 아니므로
# 재생성할 때마다 확인해야 한다:
#   docker inspect gimp-web --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}'
#
# 이 값은 nginx 가 X-Forwarded-For 를 붙여야만 의미가 있다. 붙이지 않으면
# 클라이언트가 보낸 값이 그대로 통과해 **한도가 위조로 무력화된다** -- 실제로
# 그 상태였고 ADR-0033 에서 nginx.conf 에 proxy_set_header 를 넣어 고쳤다.
TRUSTED_PROXIES=

# --- 컨테이너 실행 (ADR-0029) -------------------------------------------
# `docker compose --profile app up -d` 일 때만 쓰인다. 기본 `up -d` 는 여전히
# 인프라만 띄우므로 이 값들이 없어도 동작한다(compose 에 기본값이 있다).
WEB_PORT=80
BACKEND_PORT=8080
AI_PORT=8000

# 부하테스트용 완화 프로파일. **여기에 loadtest 를 적어두지 말 것** --
# 완화된 구성이 파일에 남으면 되돌리는 걸 잊는다(ADR-0024). 실행할 때만 넘긴다:
#   SPRING_PROFILES_ACTIVE=loadtest docker compose --profile app up -d backend
SPRING_PROFILES_ACTIVE=
